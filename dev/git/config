[user]
	name = Darren Kavanagh
	email = dkav@users.noreply.github.com
	signingKey = 1F21C5B891D5E3C66C9CF732A258D1E837E3C689
[commit]
	gpgSign = true
	verbose = true
[tag]
	gpgSign = true
[gpg]
	program = /opt/homebrew/bin/gpg
[credential]
	helper = osxkeychain

[core]
	editor = /opt/homebrew/bin/mvim -f
	pager = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight | less
[interactive]
	diffFilter = /opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight

[init]
	defaultBranch = main
	defaultRefFormat = reftable
[branch]
	sort = -committerdate
[fetch]
	prune = true
	fsckObjects = true
[pull]
	ff = only
[push]
	autoSetupRemote = true
	useForceIfIncludes = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
	instructionFormat = %s [%an] [%ai]
[rerere]
	enabled = true
	autoUpdate = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[diff]
	algorithm = histogram
	tool = vimdiff
	guitool = p4merge
	colorMoved = default
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
[diff "textutil"]
	textconv = textutil -convert txt -stdout
[difftool]
	prompt = false
[difftool "p4merge"]
	cmd = /opt/homebrew/bin/p4merge -nl Old -nr New \"$LOCAL\" \"$REMOTE\"

[merge]
	tool = vimdiff
	guitool = p4merge
	conflictStyle = zdiff3
[mergetool]
	keepBackup = false
	prompt = false
[mergetool "mvim2"]
	cmd = /opt/homebrew/bin/mvimdiff -f -M -c '2wincmd w | set modifiable | set write' \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
[mergetool "mvim3"]
	cmd = /opt/homebrew/bin/mvimdiff -f -M -c '4wincmd w | wincmd J | set modifiable | set write' \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\"
[mergetool "p4merge"]
	cmd = /opt/homebrew/bin/p4merge -nb Base -nl Local -nr Remote -nm Merged \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"

[log]
	date = format:%Y-%m-%d %H:%M
[blame]
	date = format:%Y-%m-%d %H:%M
	coloring = highlightRecent
[advice]
	diverging = false
	pushNonFFCurrent = false
	skippedCherryPicks = false
	mergeConflict = false

[alias]
	# Basic
	br = branch
	co = checkout
	cl = clone
	cm = commit
	cmm = commit --all --message
	cma = commit --all --amend --no-edit
	cmd = commit --all --amend --no-edit --date=now
	cmp = "!f() { git commit --all --message \"$1\" && git push --quiet; }; f"
	cp = cherry-pick
	gp = grep -I --ignore-case --line-number
	pl = pull
	plr = pull --rebase
	ph = push
	phf = push --force-with-lease
	rt = remote
	rs = reset
	re = restore
	sa = stash
	st = status --short
	sw = switch
	wt = worktree

	# Rebase
	rb = rebase
	rbi = rebase --interactive
	rbc = "-c core.editor=true rebase --continue"
	rbd = rebase --committer-date-is-author-date
	rba = rebase --reset-author-date

	# Diff
	df = diff
	dfc = diff --name-only --diff-filter=U # Conflicted files
	dfs = diff --staged
	dfw = diff --word-diff=color --unified=1
	dt = difftool --gui

	# Merge
	mg = merge
	mgn = merge --no-ff
	mt = mergetool --gui

	# Log
	ls = log --pretty=format:'%C(yellow)%h %C(white) %<(50,trunc)%s %C(cyan)%<(15,trunc)%an %Cgreen%ad'
	ln = log --pretty=format:'%C(yellow)%h %C(white) %<(25,trunc)%s %C(cyan)%<(15,trunc)%an %ad %Cgreen%<(15,trunc)%cn %cd'
	lg = log --graph --color --pretty=format:'%C(yellow)%h%C(magenta)%d%C(white) %<|(65,trunc)%s %C(cyan)%<(15,trunc)%an %Cgreen%ad'
	ll = log --stat --pretty=format:'%C(yellow)%h %C(cyan)%an %Cgreen%ad%n %s%n'
	lf = log --pretty=fuller

	# Config
	ec = config --global --edit

	# Aliases
	al = "!git config --get-regexp '^alias[.]' | cut -c 7- | less -X"
